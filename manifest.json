{
  "manifest_version": 3,
  "name": "LinkedIn Job Filter",
  "version": "0.1.0",
  "description": "Custom filtering for LinkedIn job search results.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["*://www.linkedin.com/*"],
  "content_scripts": [
    {
      "matches": ["*://www.linkedin.com/jobs/*"],
      "js": ["src/content.js"]
    }
  ]
}
